{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "changes(legal_rag_model_info[1m]) > 0",
        "iconColor": "#FADE2A",
        "name": "Model Deployments",
        "step": "1m",
        "tagKeys": "version",
        "text": "Model Deployment / Version Transition"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Row 1: High-Level Business SLAs & Service Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "title": "Inference Throughput (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(legal_rag_predictions_total[1m])) by (model_version)",
          "legendFormat": "{{model_version}} RPS"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.5 },
              { "color": "red", "value": 2.0 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "title": "p95 End-to-End Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(legal_rag_prediction_latency_seconds_bucket{stage=\"total\"}[5m])) by (le, stage))",
          "legendFormat": "p95 Total Latency"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "title": "Error Rate Ratio (SLA < 1%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(rate(legal_rag_predictions_total{status=\"error\"}[5m])) or vector(0)) / (sum(rate(legal_rag_predictions_total[5m])) > 0 or vector(1))",
          "legendFormat": "Error Rate"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "title": "In-Flight Active Requests",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(legal_rag_inflight_requests)",
          "legendFormat": "Active Requests"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 200,
      "title": "Row 2: Pipeline Stage Breakdown & Latency Anatomy",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "stacking": { "mode": "normal" } },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "title": "Stage Latency Anatomy (Retrieval vs Generation)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(legal_rag_prediction_latency_seconds_bucket{stage!=\"total\"}[5m])) by (le, stage))",
          "legendFormat": "p95 Stage: {{stage}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "title": "Retrieval Share of Latency (% Queue vs Inference)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(legal_rag_prediction_latency_seconds_sum{stage=\"retrieval\"}[5m])) / (sum(rate(legal_rag_prediction_latency_seconds_sum{stage=\"total\"}[5m])) > 0 or vector(1))",
          "legendFormat": "Retrieval Share %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 300,
      "title": "Row 3: Quality, Guardrails & Drift Monitoring",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 19 },
      "id": 7,
      "title": "Retrieval Similarity Score Distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(legal_rag_prediction_score_bucket[5m])) by (le))",
          "legendFormat": "Median Score (p50)"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(legal_rag_prediction_score_bucket[5m])) by (le))",
          "legendFormat": "Top Score (p90)"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 19 },
      "id": 8,
      "title": "Guardrail Decisions (PII, Prompt Injection, Grounding)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(legal_rag_guardrail_decisions_total[5m])) by (guardrail, decision)",
          "legendFormat": "{{guardrail}}: {{decision}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 19 },
      "id": 9,
      "title": "Token Bucket Rate Limiting Hits",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(legal_rag_rate_limit_hits_total[5m])) by (status)",
          "legendFormat": "Status: {{status}}"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres-drift" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "id": 12,
      "title": "Evidently Drift Share (PostgreSQL)",
      "type": "timeseries",
      "targets": [
        {
          "rawSql": "SELECT timestamp AS \"time\", share_drifted_features AS \"drift_share\" FROM drift_metrics ORDER BY 1 ASC",
          "format": "time_series"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 400,
      "title": "Row 4: Infrastructure & Container Resource Utilization",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 10,
      "title": "CPU Utilization (API Process & Host)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"legal_rag_api\"}[1m]) * 100",
          "legendFormat": "Legal RAG Process CPU %"
        },
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "Host Total CPU %"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 11,
      "title": "Memory Utilization (API RSS & Host)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"legal_rag_api\"}",
          "legendFormat": "Legal RAG Process RSS"
        },
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Host Used RAM"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["mlops", "module-5", "legal-rag"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(legal_rag_predictions_total, model_version)",
        "includeAll": true,
        "name": "model_version",
        "query": "label_values(legal_rag_predictions_total, model_version)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up, instance)",
        "includeAll": true,
        "name": "instance",
        "query": "label_values(up, instance)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Arabic Legal RAG — System & Model Observability",
  "uid": "legal-rag-observability",
  "version": 1
}
